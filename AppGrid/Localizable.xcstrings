    "“Recently used” counts launches from AppGrid — the system list only covers the Dock.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "“Recently used” counts launches from AppGrid — the system list only covers the Dock."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "„Ostatnio używane” liczy uruchomienia z AppGrida — systemowa lista obejmuje tylko Dock."
          }
        }
      }
    },
    "“Restore alphabetical order” only clears the order and the separators. Icons moved to the other section are brought back by the separate button.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "“Restore alphabetical order” only clears the order and the separators. Icons moved to the other section are brought back by the separate button."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "„Przywróć kolejność alfabetyczną” kasuje samą kolejność i belki. Ikony przełożone do drugiej sekcji wracają osobnym przyciskiem."
          }
        }
      }
