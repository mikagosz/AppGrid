    "Hide an app with the right mouse button on its icon. Hidden apps come back the moment you type in the search field.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Hide an app with the right mouse button on its icon. Hidden apps come back the moment you type in the search field."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Program ukrywasz prawym przyciskiem na jego ikonie. Ukryte wracają, gdy tylko coś wpiszesz w szukajkę."
          }
        }
      }
    },
